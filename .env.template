# -----------------------------------------------------------------------------
# TEMPLATE ONLY — DO NOT USE AS REAL SECRETS
#
# Copy this file to `.env` and fill in real values:
#   cp .env.template .env
#
# `.env` must NEVER be committed (see .gitignore). Use strong passwords.
# Sensitive values (SECRET_KEY, OPENAI_API_KEY) use SecretStr in Pydantic.
# Generate a secure SECRET_KEY:
#   openssl rand -hex 32
#
# Pydantic nested settings:
#   env_nested_delimiter="__"
#   Example: AI__MODEL maps to settings.ai.model
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Required — Application environment name (default: development).
APP_ENV=development
# Required — Debug mode (default: false).
APP_DEBUG=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Required — JWT signing key (default: none).
SECRET_KEY=change_me_generate_with_openssl
# Required — JWT expiration in minutes (default: 10080).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Required — PostgreSQL connection string.
DATABASE_URL=postgresql://lemello:change_me_strong_password@localhost:5432/lemello

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Required — Redis connection string (password required for local dev).
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# -----------------------------------------------------------------------------
# OpenAI / AI Configuration
# -----------------------------------------------------------------------------
# Required — OpenAI API key (starts with sk-).
OPENAI_API_KEY=sk-change_me
# Optional — Chat model (default: gpt-4o).
AI__MODEL=gpt-4o
# Optional — Response randomness 0.0-1.0 (default: 0.7).
AI__TEMPERATURE=0.7
# Optional — Max response tokens (default: 2048).
AI__MAX_TOKENS=2048
# Optional — Retry attempts on failure (default: 3).
AI__MAX_RETRIES=3
# Optional — Embedding model (default: text-embedding-3-small).
AI__EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Vector Search / RAG
# -----------------------------------------------------------------------------
# Optional — Embedding dimensions (default: 1536).
VECTOR_DIMENSIONS=1536
# Optional — Similar recipes to retrieve (default: 5).
RAG_TOP_K_RECORDS=5

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
# Optional — Logging level (default: INFO).
LOG_LEVEL=INFO
# Optional — Log format TEXT or JSON (default: TEXT).
LOG_FORMAT=TEXT
# Optional — Sentry DSN for error tracking (default: none).
SENTRY_DSN=
# Optional — OpenTelemetry collector endpoint (default: none).
OTEL_ENDPOINT=
# Optional — OpenTelemetry service name (default: lemello-backend).
OTEL_SERVICE_NAME=lemello-backend

# -----------------------------------------------------------------------------
# Local development example (works with lemello-app/infra docker-compose)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://lemello:change_me_strong_password@postgres:5432/lemello
# REDIS_URL=redis://:change_me_optional@redis:6379/0
