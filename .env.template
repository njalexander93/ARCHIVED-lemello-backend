# -----------------------------------------------------------------------------
# TEMPLATE ONLY — DO NOT USE AS REAL SECRETS
#
# Copy this file to `.env` and fill in real values:
#   cp .env.template .env
#
# `.env` must NEVER be committed (see .gitignore). Use strong passwords.
# Sensitive values (SECRET_KEY, OPENAI_API_KEY) use SecretStr in Pydantic.
# Generate a secure SECRET_KEY:
#   openssl rand -hex 32
#
# Pydantic nested settings:
#   env_nested_delimiter="__"
#   Example: AI__MODEL maps to settings.ai.model
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Required — Application environment name (default: development).
APP_ENV=development
# Required — Debug mode (default: false).
APP_DEBUG=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Required — JWT signing key (minimum 32 characters).
# IMPORTANT: Generate a secure key for production with:
#   openssl rand -hex 32
# Development uses a safe default, but production will fail without this set.
SECRET_KEY=change_me_generate_with_openssl_at_least_32_chars_required
# Required — JWT expiration in minutes (default: 60).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Password Hashing (Argon2id)
# -----------------------------------------------------------------------------
# Argon2id parameters aligned with OWASP Password Storage Cheat Sheet.
# Defaults use OWASP Option B — suitable for 1 GiB containers.
# Verification reads parameters from stored hashes, so changing these
# values only affects NEW password hashes. Existing passwords always
# verify correctly regardless of current configuration.
#
# OWASP recommended configurations (all provide equivalent security):
#   Option A: m=47104, t=1, p=1  (46 MiB — use with 2+ GiB RAM)
#   Option B: m=19456, t=2, p=1  (19 MiB — default, fits 1 GiB)
#   Option C: m=12288, t=3, p=1  (12 MiB)
#   Option D: m=9216,  t=4, p=1  ( 9 MiB)
#   Option E: m=7168,  t=5, p=1  ( 7 MiB — OWASP minimum floor)
#
# Optional — Memory cost in KiB (default: 19456, minimum: 7168).
ARGON2_MEMORY_COST=19456
# Optional — Number of iterations (default: 2, minimum: 1).
ARGON2_TIME_COST=2
# Optional — Degree of parallelism (default: 1, minimum: 1).
ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Required — PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://lemello:change_me_strong_password@localhost:5432/lemello

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Required — Redis connection string (password required for local dev).
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# -----------------------------------------------------------------------------
# OpenAI / AI Configuration
# -----------------------------------------------------------------------------
# Required — OpenAI API key (starts with sk-).
OPENAI_API_KEY=sk-change_me
# Optional — Chat model (default: gpt-4o).
AI__MODEL=gpt-4o
# Optional — Response randomness 0.0-1.0 (default: 0.7).
AI__TEMPERATURE=0.7
# Optional — Max response tokens (default: 2048).
AI__MAX_TOKENS=2048
# Optional — Retry attempts on failure (default: 3).
AI__MAX_RETRIES=3
# Optional — Embedding model (default: text-embedding-3-small).
AI__EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Vector Search / RAG
# -----------------------------------------------------------------------------
# Optional — Embedding dimensions (default: 1536).
VECTOR_DIMENSIONS=1536
# Optional — Similar recipes to retrieve (default: 5).
RAG_TOP_K_RECORDS=5

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
# Optional — Logging level (default: INFO).
LOG_LEVEL=INFO
# Optional — Log format TEXT or JSON (default: TEXT).
LOG_FORMAT=TEXT
# Optional — Enable file logging for TEXT format (default: false).
LOG_FILE_ENABLED=false
# Optional — Sentry DSN for error tracking (default: none).
SENTRY_DSN=
# Optional — OpenTelemetry collector endpoint (default: none).
OTEL_ENDPOINT=
# Optional — OpenTelemetry service name (default: lemello-backend).
OTEL_SERVICE_NAME=lemello-backend

